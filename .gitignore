# ---------------------------------------------------------------------------
# 砚池 (Inkwell) —— 个人自用的跨平台电子书阅读器
# ---------------------------------------------------------------------------

# --- 依赖 ---
node_modules/
.pnpm-store/
.pnpm-cache/
.pnpm-state/
.pnpm-debug.log*
.toolchain/

# --- 构建产物 ---
dist/
build/
out/
target/
**/*.rs.bk
*.pdb

# --- Android ---
*.apk
*.aab
.gradle/
local.properties

# --- 签名证书与密钥（严禁提交）---
*.keystore
*.jks
*.p12
*.mobileprovision
# 整个 keystore 目录都不进仓库，包括 credentials.txt（用文件通配，不要只写 *.jks）
personal/keystore/*
!personal/keystore/.gitkeep

# --- 环境变量（严禁提交）---
.env
.env.*
!.env.example
!.env.*.example

# --- 私有层产物 ---
# 工具链安装包下载缓存（VS 引导程序等，体积大且可重新下载）
personal/tools/
personal/build/
personal/out/
personal/tmp/
personal/secrets/

# --- 编辑器 / 系统 ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- 日志 / 临时 ---
*.log
!pnpm-debug.log
npm-debug.log*
yarn-error.log*
*.tsbuildinfo
coverage/
playwright-report/
test-results/
/tmp/
