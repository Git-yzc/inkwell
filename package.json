{
  "name": "inkwell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "砚池 (Inkwell) —— 个人自用的跨平台电子书阅读器",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
