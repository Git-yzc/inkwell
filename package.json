    "format": "biome format --write .",
    "format_check": "biome format .",
    "tauri": "node ./personal/scripts/tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "tailwindcss": "^4",
    "typescript": "^5.9",
    "vite": "^7"
